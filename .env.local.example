# ── Private Offer email delivery ─────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Recipient for all Private Offer submissions
PRIVATE_OFFER_RECIPIENT=office@soletahomes.com

# Recipient for general /contact inquiries (separate from Private Offer)
CONTACT_RECIPIENT=office@soletahomes.com

# SMTP credentials — use any provider (Gmail, Outlook, custom server, etc.)
# For Gmail: enable "App Passwords" under your Google account security settings.
# For custom SMTP: use the credentials provided by your host.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password-here

# The From address shown in the outgoing email
SMTP_FROM="Soleta Website <your-sending-address@gmail.com>"

# ── Tikka lead webhook ───────────────────────────────────────────────────────
# Forwards every contact/offer submission to Tikka as a lead, in parallel
# with the email above. Leave both empty to skip forwarding entirely
# (sending is "skipped"/"not_configured" — email delivery is unaffected).
# TIKKA_WEBHOOK_SECRET must be the base64url encoding of exactly 32 random
# bytes (the shared HMAC-SHA256 signing secret).
TIKKA_WEBHOOK_URL=
TIKKA_WEBHOOK_SECRET=
